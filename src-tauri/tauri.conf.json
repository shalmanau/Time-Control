{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Time Ledger",
  "version": "0.2.0",
  "identifier": "app.timeledger.personal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Time Ledger",
        "width": 1100,
        "height": 780,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "A quiet record of your time",
    "android": {
      "minSdkVersion": 26
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2MEU4RjU1MTZBNEQyRTkKUldUcDBxUVdWWThPeG1vSDZQSlRUTU96TjRmT0R3QkwrZnZFZFhIQ2doVWJkd3krSEpsVy96ckoK",
      "endpoints": [
        "https://github.com/shalmanau/Time-Control/releases/latest/download/latest.json"
      ]
    }
  }
}
